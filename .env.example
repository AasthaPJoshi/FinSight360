# ══════════════════════════════════════════════════════
# FinSight360 — Environment Configuration
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════

# ── Data source ───────────────────────────────────────
# "edgar" = live SEC API (no key needed, respects rate limits)
# "kaggle" = local CSV export (faster, needs kaggle credentials)
DATA_SOURCE=edgar

# ── Database ──────────────────────────────────────────
DUCKDB_PATH=data/finsight360.duckdb

# ── Kaggle (optional, only if DATA_SOURCE=kaggle) ─────
KAGGLE_DATA_DIR=data/kaggle
KAGGLE_MAX_COMPANIES=100
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# ── Graph database (Neo4j) ────────────────────────────
# Optional — only needed for graph-build CLI command
# Start with: docker-compose up neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=finsight360

# ── AI / GenAI ────────────────────────────────────────
# Google Gemini API — used for the AI Analyst chat page
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI — used for RAG vector embeddings (optional feature)
# Only required if running: python -m finsight360.cli rag-index
OPENAI_API_KEY=sk-...

# ── GenAI model settings ──────────────────────────────
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_CONTEXT_TOKENS=8000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHROMA_PERSIST_DIR=data/chromadb

# ── MLflow experiment tracking ────────────────────────
# Optional — start with: docker-compose up mlflow
MLFLOW_TRACKING_URI=http://localhost:5001

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
